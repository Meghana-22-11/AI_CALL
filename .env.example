# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini model name (default: gemini-1.5-flash)
GENIE_MODEL_NAME=gemini-1.5-flash

# Twilio credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio voice number
TWILIO_FROM_NUMBER=your_twilio_from_number_here

# The student phone number to call
STUDENT_PHONE_NUMBER=your_default_student_phone_number_here

# The public HTTPS webhook URL for /voice (automatically updated by run_ngrok.py)
VOICE_WEBHOOK_URL=your_ngrok_url_here

# Ngrok authtoken (used by run_ngrok.py)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
